# SecondSun environment. Copy to .env and fill in. Every key may be left empty:
# the app boots with all keys missing and falls back to mock / demo mode.
# Never put secrets in the web app. The only value the browser may see is the public
# ElevenLabs agent id (VITE_ELEVENLABS_AGENT_ID).

# ---------------------------------------------------------------------------
# OpenRouter (api only, never sent to the browser)
# Pick current model IDs from https://openrouter.ai/models. Do not hard-code them in source.
# Capabilities each slot needs:
#   VISION   : accepts image input (nameplate reading, damage suggestions)
#   PARSE    : small and fast, reliable JSON / structured output or tool calling
#              (used in the voice loop to map speech to an answer option)
#   EXPLAIN  : strong writing, good Tamil and Hindi quality
#   FALLBACK : any model that supports structured output; used when a primary errors
#              or is rate limited
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=SecondSun
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_PARSE=
OPENROUTER_MODEL_EXPLAIN=
OPENROUTER_MODEL_FALLBACK=

# live  = call OpenRouter
# cache = serve cached answers, call live only on a miss (works offline for the demo script)
# mock  = deterministic fixtures, never touches the network
LLM_MODE=mock
LLM_TIMEOUT_MS=20000
# Hard stop to protect credits.
LLM_DAILY_CALL_CAP=2000

# ---------------------------------------------------------------------------
# ElevenLabs voice agent (public agent with client tools)
# ---------------------------------------------------------------------------
# Public agent id. The web app reads VITE_ELEVENLABS_AGENT_ID, so set both to the same value.
ELEVENLABS_AGENT_ID=
VITE_ELEVENLABS_AGENT_ID=
# Optional. Only used when VOICE_AUTH_MODE=signed (server requests a signed URL).
ELEVENLABS_API_KEY=
# public | signed
VOICE_AUTH_MODE=public
# live | mock  (mock = scripted "Demo voice", no ElevenLabs needed)
VOICE_MODE=mock

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Leave MONGO_URL empty for local dev (in-memory database). docker-compose sets it to
# mongodb://mongo:27017/secondsun
MONGO_URL=
# 127.0.0.1 rather than localhost: Node can resolve localhost to ::1 while uvicorn listens on IPv4.
SIM_URL=http://127.0.0.1:8000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./api/uploads
API_PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# sim
# ---------------------------------------------------------------------------
SIM_PORT=8000
# Folder holding priors.json and assumptions.json.
DATA_DIR=../data

# ---------------------------------------------------------------------------
# web
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
