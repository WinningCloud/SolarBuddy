{
  "name": "secondsun",
  "private": true,
  "version": "0.1.0",
  "description": "Field tool for deciding whether a used PV panel should be repaired, reused or recycled.",
  "workspaces": [
    "packages/*",
    "web",
    "api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:sim": "node scripts/dev.mjs sim",
    "setup:sim": "node scripts/dev.mjs setup-sim",
    "test:sim": "node scripts/dev.mjs test-sim",
    "seed": "npm run seed -w api",
    "build": "npm run build -w web && npm run build -w api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
